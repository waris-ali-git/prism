# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=                  # a Flash-class model that is free-tier in AI Studio (see section 14)
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_CONCURRENCY=2
GEMINI_THINKING_BUDGET=        # optional; only if the chosen model supports it
QUIZ_VERIFY_ENABLED=false      # extra Gemini call that re-checks quiz answers

# --- Firebase / Firestore (Spark plan) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=      # local path to service-account JSON (never commit)
FIREBASE_SERVICE_ACCOUNT_B64=        # base64 of that JSON, used on Render instead of the path
COLLECTION_PREFIX=dev_               # prefix for results + topic_stats. EMPTY on the live demo.

# --- Second API (BLOCKED until Laiba provides the spec, see B7) ---
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
EXTERNAL_API_AUTH_HEADER=Authorization
EXTERNAL_API_AUTH_SCHEME=Bearer      # use empty string if the API takes the raw key
EXTERNAL_API_TIMEOUT_SECONDS=20

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; add https://<project>.web.app and .firebaseapp.com for prod
RATE_LIMIT_LESSON_PER_MIN=6
RATE_LIMIT_RESULT_PER_MIN=30
MAX_IMAGE_BYTES=4000000
